# pnpm dev — local development.
# Committed on purpose: no secrets here (they go to .env.local, gitignored).

# Dev server port; SITE_URL is derived automatically: http://localhost:<PORT>
PORT=3000
# none = don't open a browser tab on start
BROWSER=

# Build
SOURCEMAPS=true
MINIFY=false
OPTIMIZE_IMAGES=false
SORT_MEDIA_QUERIES=false
SITEMAP=false
ROBOTS=false
