# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/

# Environment — .env.development/.env.production are committed (no secrets);
# real values go to .env.local
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Caches (linters/tsc live under node_modules/.cache)
.cache/
.eslintcache
.stylelintcache

# Editor & IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Handoff archives (generated by `pnpm zip`)
*.zip

# Misc
*.local
.tmp/
