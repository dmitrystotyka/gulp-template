{
  "name": "gulp-template",
  "description": "Modern Gulp 5 template for fast frontend development",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "author": "HolyMolly",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "prepare": "node gulp/utils/prepare.js && husky || true",
    "dev": "cross-env NODE_ENV=development gulp dev",
    "build:dev": "cross-env NODE_ENV=development gulp build:dev",
    "build:prod": "cross-env NODE_ENV=production gulp build:prod",
    "build:handoff": "cross-env NODE_ENV=production BUILD_TARGET=handoff gulp build:handoff",
    "preview": "pnpm build:prod && cross-env NODE_ENV=production gulp preview",
    "serve": "cross-env NODE_ENV=production gulp preview",
    "zip": "pnpm build:handoff && node scripts/check-dist.mjs --mode=handoff && node .template/setup/zip.js",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0 --cache --cache-location node_modules/.cache/stylelint/",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm lint:css && pnpm format:check",
    "check:dist": "node scripts/check-dist.mjs",
    "tailwind:setup": "node .template/setup/tailwind/setup.js",
    "clean:demo": "node .template/setup/clean-demo.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "clean:cache": "node -e \"['node_modules/.cache', '.eslintcache', '.stylelintcache'].forEach((p) => fs.rmSync(p, { recursive: true, force: true }))\"",
    "clean:all": "node -e \"['node_modules', 'dist'].forEach((p) => fs.rmSync(p, { recursive: true, force: true }))\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-file-include": "^2.3.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.2"
  }
}
