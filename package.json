{
  "name": "gulp-template",
  "description": "Modern Gulp 5 template for fast frontend development",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "author": "Dmitry Stotyka (https://dmitrystotyka.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "prepare": "node gulp/utils/prepare.js",
    "dev": "cross-env NODE_ENV=development gulp dev",
    "build": "cross-env NODE_ENV=production gulp build",
    "preview": "pnpm build && cross-env NODE_ENV=production gulp preview",
    "zip": "cross-env BUILD_TARGET=handoff pnpm build && node .template/checks/check-dist.mjs --mode=handoff && pnpm validate && node .template/setup/zip.js",
    "theme": "cross-env BUILD_TARGET=handoff pnpm build && node .template/checks/check-dist.mjs --mode=handoff && pnpm validate && node .template/setup/theme/build.js && node .template/checks/check-theme.mjs && node .template/setup/zip.js --dir=wp-theme --suffix=wp-theme --root",
    "page": "node .template/setup/page.js",
    "validate": "html-validate \"dist/**/*.html\"",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.{css,scss}\" --max-warnings 0 --cache --cache-location node_modules/.cache/stylelint/",
    "fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.{css,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/ && prettier --write .",
    "check": "pnpm lint && prettier --check .",
    "tailwind:setup": "node .template/setup/tailwind/setup.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-file-include": "^2.3.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.18.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.2"
  }
}
