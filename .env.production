# pnpm build / pnpm preview — production deploy (Vercel, static hosting).
# Committed on purpose: no secrets here (they go to .env.local, gitignored).

# Public URL — canonical, og:url, absolute og:image, sitemap, robots
SITE_URL=https://example.com

# Build
SOURCEMAPS=false
MINIFY=true
OPTIMIZE_IMAGES=true
# Moves media queries to the end of each stylesheet (smaller gzip)
SORT_MEDIA_QUERIES=true
SITEMAP=false
ROBOTS=false
